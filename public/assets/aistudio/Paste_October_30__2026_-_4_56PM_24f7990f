double NormalizeLots(double lots)
  {
   const double minVolume  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   const double maxVolume  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   const double volumeStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(lots < minVolume)
      lots = minVolume;
   if(lots > maxVolume)
      lots = maxVolume;

   int digits = 2;
   if(volumeStep > 1.0 - 1e-6)
      digits = 0;
   else if(volumeStep > 0.1 - 1e-6)
      digits = 1;
   else if(volumeStep > 0.01 - 1e-6)
      digits = 2;
   else
      digits = 3;

   lots = NormalizeDouble(lots, digits);
   lots = MathRound(lots / volumeStep) * volumeStep;
   lots = NormalizeDouble(lots, digits);

   if(lots < minVolume)
      lots = minVolume;
   if(lots > maxVolume)
      lots = maxVolume;

   return lots;
  }
