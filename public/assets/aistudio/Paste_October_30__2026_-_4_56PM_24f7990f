void UpdatePositions(void)
  {
   int index = 0;

   for(int posIndex = 0, len = PositionsTotal(); posIndex < len; posIndex++)
     {
      const ulong posTicket = PositionGetTicket(posIndex);

      if(PositionSelectByTicket(posTicket) &&
         PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == Magic_Number)
        {
         if(ArraySize(positions) <= index)
            ArrayResize(positions, MathMax(ArraySize(positions) * 2, 1));

         positions[index].type           = (int) PositionGetInteger(POSITION_TYPE);
         positions[index].ticket         = posTicket;
         positions[index].magicNumber    = Magic_Number;
         positions[index].lots           = NormalizeLots(PositionGetDouble(POSITION_VOLUME));
         positions[index].timeOpen       = (datetime) PositionGetInteger(POSITION_TIME);
         positions[index].priceOpen      = NormalizeDouble(PositionGetDouble(POSITION_PRICE_OPEN),    _Digits);
         positions[index].priceCurrent   = NormalizeDouble(PositionGetDouble(POSITION_PRICE_CURRENT), _Digits);
         positions[index].stopLoss       = NormalizeDouble(PositionGetDouble(POSITION_SL), _Digits);
         positions[index].takeProfit     = NormalizeDouble(PositionGetDouble(POSITION_TP), _Digits);
         positions[index].floatingProfit = NormalizeDouble(PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP), 2);
         index++;
        }
     }

   positionsCount = index;
   if(ArraySize(positions) != positionsCount)
      ArrayResize(positions, positionsCount);
  }
