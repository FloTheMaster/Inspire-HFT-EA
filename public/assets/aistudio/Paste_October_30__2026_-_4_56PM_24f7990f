void ManageGridCurrencyExit(void)
  {
   if(positionsCount == 0)
      return;

   double totalProfit = 0;
   for(int i = 0; i < positionsCount; i++)
      totalProfit += positions[i].floatingProfit;

   if(GridStopLossCurrency > 0.001 && totalProfit <= -GridStopLossCurrency)
     {
      ClosePositions();
      EnsurePositionCloseUpdate();
      UpdateGridEntryPrice();
      return;
     }

   if(GridTakeProfitCurrency < 0.01)
      return;

   if(totalProfit >= GridTakeProfitCurrency)
     {
      ClosePositions();
      EnsurePositionCloseUpdate();
      UpdateGridEntryPrice();
      return;
     }

   if(!GridPairClosing || positionsCount < 2 || positions[positionsCount - 1].floatingProfit <= 0)
      return;

   double sumProfit = positions[0].floatingProfit;
   for(int i = positionsCount - 1; i > 0; i--)
     {
      sumProfit += positions[i].floatingProfit;
      if(sumProfit >= GridTakeProfitCurrency)
        {
         for(int j = positionsCount - 1; j >= i; j--)
            ClosePosition(positions[j]);
         ClosePosition(positions[0]);
         EnsurePositionCountUpdated(i - 1);
         UpdateGridEntryPrice();
         return;
        }
     }

   const double volumeStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   const double countSteps = MathMax(1.0, MathRound(positions[0].lots / volumeStep));

   sumProfit = NormalizeDouble(positions[0].floatingProfit / countSteps, 2);
   for(int i = positionsCount - 1; i > 0; i--)
     {
      sumProfit += positions[i].floatingProfit;
      if(sumProfit >= GridTakeProfitCurrency)
        {
         for(int j = positionsCount - 1; j >= i; j--)
            ClosePosition(positions[j]);
         const double minVolume = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
         const bool isFirstWillCloseFully = positions[0].lots <= minVolume + sigma;
         ClosePositionPartial(positions[0], minVolume);
         EnsurePositionCountUpdated(isFirstWillCloseFully ? i - 1 : i);
         UpdateGridEntryPrice();
         return;
        }
     }
  }
