bool OpenPosition(const int command, const double entryAmount, const double stopLossPrice, const double takeProfitPrice)
  {
   const int spread = (int)((Ask() - Bid()) / _Point);

   statusMessage = "";
   if(!IsTradeAllowed())
      statusMessage += "Algo Trading is disabled\n";
   if(Max_OpenPos > sigma && posStatCount >= Max_OpenPos)
      statusMessage += StringFormat("Protection: Max open positions: %d, current: %d\n", Max_OpenPos, posStatCount);
   if(Max_OpenLots > sigma && posStatLots > Max_OpenLots - sigma)
      statusMessage += StringFormat("Protection: Max open lots: %.2f, current: %.2f\n", Max_OpenLots, posStatLots);
   if(Max_Spread > sigma && spread > Max_Spread)
      statusMessage += StringFormat("Protection: Max spread: %d, current: %d\n", Max_Spread, spread);
   if(MaxDailyLoss > sigma && dailyLoss >= MaxDailyLoss)
      statusMessage += StringFormat("Protection: Max daily loss: %d, current: %.2f\n", MaxDailyLoss, dailyLoss);
   if(Max_Daily_DD > sigma && dailyDrawdown >= Max_Daily_DD)
      statusMessage += StringFormat("Protection: Max daily drawdown: %.2f%%, current: %.2f%%\n", Max_Daily_DD, dailyDrawdown);
   if(GlobalVariableGet(accEntrySuspendGlobalVarName) > sigma)
      statusMessage += StringFormat("New entries are suspended until the Daily reset hour: %d\n", Daily_Reset);

   const int newsIndex = NewsFilterActive();
   if(newsIndex > -1)
     {
      const NewsRecord newsRecord = newsRecords[newsIndex];
      statusMessage += StringFormat("News filter: %s %s %s %s\n",
                                    newsRecord.priority == "high" ? "[high]" : "[med]",
                                    TimeToString(newsRecord.time, TIME_DATE | TIME_MINUTES),
                                    newsRecord.currency,
                                    newsRecord.title);
     }

   if(statusMessage != "")
     {
      statusMessage = TimeToString(TimeCurrent()) + " " + "An entry order was canceled:\n" + statusMessage;
      return false;
     }

   return ManageOrderSend(command, entryAmount, stopLossPrice, takeProfitPrice, 0);
  }
