void OnBar(void)
  {
   if(positionsCount > 0 && IsForceSessionClose())
     {
      ClosePositions();
      EnsurePositionCloseUpdate();
      return;
     }

   if(IsOutOfSession())
      return;

   if(positionsCount > 0)
      ManageClose();

   if(isTrailingStop && positionsCount == 1)
      ManageTrailingStop();

   const int entrySignal = GetEntrySignal();

   if(OppositeReverseEnabled && entrySignal != OP_FLAT && positionsCount > 0)
      ManageOppositeEntrySignal(entrySignal);

   if(positionsCount == 0 && entrySignal != OP_FLAT)
     {
      const double entryLots       = NormalizeLots(Entry_Amount);
      const double stopLossPrice   = GetStopLossPrice(entrySignal);
      const double takeProfitPrice = GetTakeProfitPrice(entrySignal);
      OpenPosition(entrySignal, entryLots, stopLossPrice, takeProfitPrice);
      UpdatePositions();
     }
  }
