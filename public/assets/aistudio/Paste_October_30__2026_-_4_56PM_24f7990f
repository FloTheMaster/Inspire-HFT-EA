void ManageTrailingStop(void)
  {
   for(int i = positionsCount - 1; i >= 0; i--)
     {
      const Position position = positions[i];
      const double trailingStop = GetTrailingStopPrice(position);
      if((position.type == OP_BUY  && MathAbs(trailingStop - Bid()) < _Point) ||
         (position.type == OP_SELL && MathAbs(trailingStop - Ask()) < _Point))
        {
         ClosePosition(positions[i]);
         continue;
        }

      if(MathAbs(trailingStop - position.stopLoss) > _Point)
         ModifyPositionByTicket(position.ticket, trailingStop, position.takeProfit);
     }
  }
