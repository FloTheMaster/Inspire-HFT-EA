     {
      const ushort ch = StringGetCharacter(_Symbol, i);
      const bool isDigit = ch >= '0' && ch <= '9';
      const bool isUpper = ch >= 'A' && ch <= 'Z';
      const bool isLower = ch >= 'a' && ch <= 'z';

      if(isDigit || isUpper || isLower || ch == '_')
         fixedSymbol += CharToString((uchar) ch);
      else
         fixedSymbol += StringFormat("_%d_", ch);
     }

   if(fixedSymbol == "")
      fixedSymbol = "symbol";

   return "orderFillingType_" + fixedSymbol;
