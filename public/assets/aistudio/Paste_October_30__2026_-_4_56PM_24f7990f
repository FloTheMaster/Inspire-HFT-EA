void LoadNews(void)
  {
   const int currenciesCount = ArraySize(newsCurrencies);
   datetime timeFrom = TimeTradeServer() - News_AfterHigh * 60;
   datetime timeTo   = timeFrom + 24 * 60 * 60; // Next 24 hours

   MqlCalendarEvent event;
   MqlCalendarValue values[];
   ArrayResize(newsRecords, 20);
   int newsIndex = 0;

   for(int i = 0; i < currenciesCount; i++)
     {
      const string currency = newsCurrencies[i];

      const int valuesCount = CalendarValueHistory(values, timeFrom, timeTo, NULL, currency);

      for(int j = 0; j < valuesCount; j++)
        {
         if(!CalendarEventById(values[j].event_id, event))
            continue;
         if(event.time_mode != CALENDAR_TIMEMODE_DATETIME &&
            event.time_mode != CALENDAR_TIMEMODE_TENTATIVE)
            continue;
         if(event.importance != CALENDAR_IMPORTANCE_HIGH &&
            event.importance != CALENDAR_IMPORTANCE_MODERATE)
            continue;
         if(News_Priority == NewsFilter_HighOnly &&
            event.importance == CALENDAR_IMPORTANCE_MODERATE)
            continue;

         NewsRecord record;
         record.time     = values[j].time;
         record.priority = event.importance == CALENDAR_IMPORTANCE_HIGH ? "high" : "medium";
         record.currency = currency;
         record.title    = event.name;
         newsRecords[newsIndex] = record;

         newsIndex++;
         if(newsIndex >= ArraySize(newsRecords))
            ArrayResize(newsRecords, 2 * ArraySize(newsRecords));
        }
     }

   ArrayResize(newsRecords, newsIndex);
   SortNewsRecords();
   lastNewsUpdate = TimeCurrent();
  }
//+------------------------------------------------------------------+
//| Sorts the news records by event time                             |
//+------------------------------------------------------------------+
void SortNewsRecords(void)
  {
   datetime times[];
   const int len = ArraySize(newsRecords);
   ArrayResize(times, len);
   for(int i = 0; i < len; i++)
      times[i] = newsRecords[i].time;

   ArraySort(times);

   for(int i = 0; i < len; i++)
     {
      const datetime time = times[i];
      for(int j = i; j < len; j++)
         if(newsRecords[j].time == time)
           {
            if(i != j)
              {
               const NewsRecord tempRecord = newsRecords[i];
               newsRecords[i] = newsRecords[j];
               newsRecords[j] = tempRecord;
              }
            break;
           }
     }
  }
