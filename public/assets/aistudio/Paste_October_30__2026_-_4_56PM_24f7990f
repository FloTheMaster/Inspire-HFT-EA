void UpdateGridEntryPrice(void)
  {
   gridEntryPrice = 0;

   if(!GridEnable || positionsCount == 0)
      return;

   double gridDistanceDelta         = PipsToPoints(GridDistancePips);
   double gridDistanceStep          = gridDistanceDelta;
   double gridDistanceFibonacciPrev = gridDistanceStep;
   double gridDistanceFibonacciCurr = gridDistanceStep + gridDistanceStep;

   for(int i = 1; i < positionsCount; i += 1)
     {
      double delta = gridDistanceStep;
      switch(GridDistanceSizing)
        {
         case EGridDistanceSizing_Equal:
            break;
         case EGridDistanceSizing_Increment:
            delta += PipsToPoints(GridDistanceIncrement);
            break;
         case EGridDistanceSizing_Scale:
            delta *= GridDistanceScale;
            break;
         case EGridDistanceSizing_Fibonacci:
           {
            delta = gridDistanceFibonacciCurr;
            gridDistanceFibonacciCurr += gridDistanceFibonacciPrev;
            gridDistanceFibonacciPrev  = delta;
            break;
           }
         default:
            break;
        }

      if(GridMaxDistance > 0)
         delta = MathMin(delta, PipsToPoints(GridMaxDistance));
      gridDistanceStep   = delta;
      gridDistanceDelta += delta;
     }

   const double sign = positions[0].type == OP_BUY ? -1 : 1;
   gridEntryPrice = NormalizeDouble(positions[0].priceOpen + sign * gridDistanceDelta * _Point, _Digits);
  }
