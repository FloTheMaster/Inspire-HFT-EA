//|                                                                  |
//+------------------------------------------------------------------+
double GetTrailingStopPrice(const Position &position)
  {
   const double bid = Bid();
   const double ask = Ask();
   const double stopLevelPoints = _Point * stopLevel;
   const double stopLossPoints  = pip * Stop_Loss;

   double stopLoss = position.stopLoss;

   if(position.type == OP_BUY)
     {
      const double newStopLoss = High(1) - stopLossPoints;
      if(position.stopLoss <= newStopLoss - pip)
         stopLoss = newStopLoss < bid ? newStopLoss >= bid - stopLevelPoints
                                          ? bid - stopLevelPoints
                                          : newStopLoss
                                          : bid;
     }
   else if(position.type == OP_SELL)
     {
      const double spread      = ask - bid;
      const double newStopLoss = Low(1) + spread + stopLossPoints;
      if(position.stopLoss >= newStopLoss + pip)
         stopLoss = newStopLoss > ask ? newStopLoss <= ask + stopLevelPoints
                                          ? ask + stopLevelPoints
                                          : newStopLoss
                                          : ask;
     }

   return NormalizeDouble(stopLoss, _Digits);
  }
