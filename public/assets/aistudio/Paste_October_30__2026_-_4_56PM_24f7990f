void ManageGridEntry(void)
  {
   if(positionsCount == 0)
      return;

   if(GridMinTimeInterval > 0)
     {
      const datetime symbolTime = SymbolTime();
      const datetime entryTime  = positions[positionsCount - 1].timeOpen;
      if(symbolTime < entryTime + 3600 * GridMinTimeInterval)
         return;
     }

   const int entryDir  = positions[0].type;
   if((entryDir == OP_BUY  && Ask() <= gridEntryPrice) ||
      (entryDir == OP_SELL && Bid() >= gridEntryPrice))
     {
      const double entryVolume     = GetGridEntryVolume();
      const double stopLossPrice   = positions[0].stopLoss;
      const double takeProfitPrice = positions[0].takeProfit;

      if(OpenPosition(entryDir, entryVolume, stopLossPrice, takeProfitPrice))
        {
         EnsurePositionCountUpdated(positionsCount + 1);
         UpdateGridEntryPrice();
        }
     }
  }
