string GetPositionStats(void)
  {
   const string positionStats  = "\n            ..:: Positions Stats ::..\n";

   if(positionsCount == 0)
      return positionStats +  "Positions: no open positions";

   double totalLots         = 0;
   double totalProfit       = 0;
   double averagePriceOpen  = 0;
   double averagePriceCurr  = 0;
   double averageStopLoss   = 0;
   double averageTakeProfit = 0;

   for(int i = 0; i < positionsCount; i++)
     {
      const Position pos = positions[i];
      totalLots         += pos.lots;
      totalProfit       += pos.floatingProfit;
      averagePriceOpen  += pos.priceOpen;
      averagePriceCurr  += pos.priceCurrent;
      averageStopLoss   += pos.stopLoss;
      averageTakeProfit += pos.takeProfit;
     }

   averagePriceOpen  /= positionsCount;
   averagePriceCurr  /= positionsCount;
   averageStopLoss   /= positionsCount;
   averageTakeProfit /= positionsCount;

   return positionStats +
          StringFormat("Positions: %s, Count: %d, Lots: %.2f, Profit %.2f\n",
                       (positions[0].type == OP_BUY) ? "Long" : "Short",
                       positionsCount,
                       totalLots, totalProfit) +
          StringFormat("Open price: %s, Current price: %s\n",
                       DoubleToString(averagePriceOpen, _Digits),
                       DoubleToString(averagePriceCurr, _Digits)) +
          StringFormat("Stop Loss: %s, Take Profit: %s",
                       DoubleToString(averageStopLoss,   _Digits),
                       DoubleToString(averageTakeProfit, _Digits));
  }
