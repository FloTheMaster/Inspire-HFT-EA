bool IsTradeContextFree(void)
  {
   if(IsTradeAllowed())
      return true;

   const uint startWait = GetTickCount();
   Print("Trade preconditions are not met. Waiting...");

   while(true)
     {
      if(IsStopped())
         return false;

      const uint totalWait = GetTickCount() - startWait;
      if(totalWait > TRADE_CONTEXT_WAIT_MAX)
        {
         Print("The waiting limit exceeded!");
         return false;
        }

      if(IsTradeAllowed())
         return true;

      Sleep(TRADE_RETRY_WAIT);
     }

   return true;
  }
