void ParseNewsCurrenciesText(void)
  {
   string parts[];
   const int partsLen = StringSplit(News_Currencies, ',', parts);
   ArrayResize(newsCurrencies, partsLen);
   int index = 0;
   for(int i = 0; i < partsLen; i++)
     {
      string part = parts[i];
      StringReplace(part, " ", "");
      if(StringLen(part) > 0)
        {
         newsCurrencies[index] = part;
         index++;
        }
     }

   ArrayResize(newsCurrencies, index);
  }
