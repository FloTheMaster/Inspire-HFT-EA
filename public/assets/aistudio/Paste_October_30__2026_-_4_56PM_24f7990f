bool IsTradeSendSuccessRetcode(const uint retcode, const bool isDeal)
  {
   if(retcode == TRADE_RETCODE_DONE)
      return true;

   if(isDeal && retcode == TRADE_RETCODE_DONE_PARTIAL)
      return true;

   if(!isDeal && retcode == TRADE_RETCODE_NO_CHANGES)
      return true;

   return false;
