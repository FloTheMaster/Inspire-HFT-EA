double GetGridEntryVolume(void)
  {
   double entryVolume    = Entry_Amount;
   double entryFibonacci = entryVolume;

   for(int i = 0; i < positionsCount; i += 1)
     {
      switch(GridVolumeSizing)
        {
         case EGridVolumeSizing_Equal:
            break;
         case EGridVolumeSizing_Increment:
            entryVolume += GridVolumeIncrement;
            break;
         case EGridVolumeSizing_Scale:
            entryVolume *= GridVolumeScale;
            break;
         case EGridVolumeSizing_Fibonacci:
           {
            const double temp = entryFibonacci;
            entryFibonacci = entryVolume;
            entryVolume += temp;
            break;
           }
         default:
            break;
        }
     }

   return NormalizeLots(entryVolume);
  }
