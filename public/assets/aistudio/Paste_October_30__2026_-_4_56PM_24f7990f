//+------------------------------------------------------------------+
bool ManageOrderSend(const int command, const double lots, const double stopLoss, const double takeProfit, const ulong ticket)
  {
   int totalDelay = 0;
   int delay      = TRADE_RETRY_WAIT;
   int attempt    = 0;

   while(totalDelay < TRADE_RETRY_WAIT_MAX)
     {
      attempt++;

      if(IsTradeContextFree())
        {
         MqlTradeRequest request;
         MqlTradeResult  result;
         ZeroMemory(request);
         ZeroMemory(result);

         request.action       = TRADE_ACTION_DEAL;
         request.symbol       = _Symbol;
         request.volume       = lots;
         request.type         = command == OP_BUY ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
         request.price        = command == OP_BUY ? Ask() : Bid();
         request.type_filling = orderFillingType;
         request.deviation    = 10;
         request.sl           = stopLoss;
         request.tp           = takeProfit;
         request.magic        = Magic_Number;
         request.position     = ticket;
         request.comment      = IntegerToString(Magic_Number);

         ResetLastError();
         if(CheckOrder(request))
           {
            ResetLastError();
            const bool isOrderSend = OrderSend(request, result);
            const uint retcode     = result.retcode;
            const int  lastError   = GetLastError();

            if(isOrderSend && IsTradeSendSuccessRetcode(retcode, true))
               return true;

            PrintFormat("OrderSend failed: attempt=%d elapsed=%dms retcode=%u comment=%s error=%d",
                        attempt, totalDelay, retcode, result.comment, lastError);

            if(!IsRetryableTradeRetcode(retcode))
               return false;
          }
         else
          {
            PrintFormat("OrderCheck failed: attempt=%d elapsed=%dms", attempt, totalDelay);
            return false;
          }
        }
      else
        {
         PrintFormat("Trade context is not free: attempt=%d elapsed=%dms", attempt, totalDelay);
        }

      Sleep(delay);
      totalDelay += delay;
      delay       = MathMin(delay * 2, TRADE_RETRY_WAIT_MAX);
      PrintFormat("Order Send retry: nextDelay=%d elapsed=%dms", delay, totalDelay);
     }

   return false;
  }
