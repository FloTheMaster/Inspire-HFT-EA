//+------------------------------------------------------------------+
bool CheckOrder(MqlTradeRequest &request)
  {
   const int maxFillAttempts = 4; // IOC, FOK, RETURN, BOC

   for(int attempt = 0; attempt < maxFillAttempts; attempt++)
     {
      MqlTradeCheckResult check;
      ZeroMemory(check);
      ResetLastError();

      if(request.action == TRADE_ACTION_DEAL)
         request.type_filling = orderFillingType;

      if(OrderCheck(request, check))
         return true;

      if(check.retcode != TRADE_RETCODE_INVALID_FILL)
        {
         Print("Error with OrderCheck: " + check.comment);
         return false;
        }

      switch(orderFillingType)
        {
         case ORDER_FILLING_IOC:
            orderFillingType = ORDER_FILLING_FOK;
            break;
         case ORDER_FILLING_FOK:
            orderFillingType = ORDER_FILLING_RETURN;
            break;
         case ORDER_FILLING_RETURN:
            orderFillingType = ORDER_FILLING_BOC;
            break;
         case ORDER_FILLING_BOC:
            orderFillingType = ORDER_FILLING_IOC;
            break;
        }

      GlobalVariableSet(fillingTypeGlobalVarName, orderFillingType);
     }

   Print("Error with OrderCheck: unsupported filling mode after trying all available options.");
   return false;
  }
